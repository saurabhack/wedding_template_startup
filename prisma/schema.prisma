generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  fullName      String
  phone         String?
  profileImage  String?
  role          String          @default("USER") // USER, PLANNER, ADMIN
  emailVerified Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  projects      WeddingProject[]
  subscriptions Subscription[]
  payments      Payment[]
  savedTemplates SavedTemplate[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
}

model WeddingProject {
  id          String   @id @default(uuid())
  userId      String
  projectName String
  brideName   String
  groomName   String
  weddingDate DateTime?
  status      String   @default("active") // active, completed, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations Invitation[]
  familyMembers FamilyMember[]
  media       InvitationMedia[]
  guests      Guest[]

  @@index([userId])
}

model TemplateCategory {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  description   String?
  categoryImage String?
  displayOrder  Int        @default(0)
  isActive      Boolean    @default(true)

  templates     Template[]

  @@index([slug])
}

model Template {
  id                  String             @id @default(uuid())
  categoryId          String
  name                String
  slug                String             @unique
  description         String?
  previewImage        String
  thumbnailImage      String?
  designConfiguration Json
  supportedLanguages  String             @default("en,hi")
  orientation         String             @default("portrait") // portrait, landscape, square
  price               Decimal            @default(0) @db.Decimal(10, 2)
  isPremium           Boolean            @default(false)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  category            TemplateCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  versions            TemplateVersion[]
  invitations         Invitation[]
  savedByUsers        SavedTemplate[]

  @@index([categoryId])
  @@index([slug])
  @@index([isPremium, isActive])
}

model TemplateVersion {
  id                  String       @id @default(uuid())
  templateId          String
  versionNumber       Int
  designConfiguration Json
  isPublished         Boolean      @default(true)
  createdAt           DateTime     @default(now())

  template            Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  invitations         Invitation[]

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

model Invitation {
  id                String            @id @default(uuid())
  projectId         String
  templateId        String
  templateVersionId String?
  invitationTitle   String
  slug              String            @unique
  invitationData    Json
  status            String            @default("draft") // draft, published, archived
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  project           WeddingProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template          Template          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion   TemplateVersion?  @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  events            InvitationEvent[]
  guestInvitations  GuestInvitation[]
  media             InvitationMedia[]

  @@index([projectId])
  @@index([slug])
  @@index([status])
}

model InvitationEvent {
  id            String     @id @default(uuid())
  invitationId  String
  eventName     String
  eventDate     DateTime?
  startTime     String?
  endTime       String?
  venue         String
  address       String?
  mapUrl        String?
  dressCode     String?
  description   String?
  coverImage    String?
  displayOrder  Int        @default(0)

  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model FamilyMember {
  id             String         @id @default(uuid())
  projectId      String
  fullName       String
  relationship   String
  photographUrl  String?
  description    String?
  displayOrder   Int            @default(0)

  project        WeddingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model InvitationMedia {
  id               String          @id @default(uuid())
  projectId        String
  invitationId     String?
  mediaType        String          // image, audio, document
  fileUrl          String
  originalFileName String?
  fileSize         Int?
  uploadedAt       DateTime        @default(now())

  project          WeddingProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitation       Invitation?     @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([invitationId])
}

model Guest {
  id          String            @id @default(uuid())
  projectId   String
  fullName    String
  familyName  String?
  phone       String?
  email       String?
  category    String            @default("General") // VIP, Bride Side, Groom Side, Family, Friend, Colleague
  notes       String?
  createdAt   DateTime          @default(now())

  project     WeddingProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitations GuestInvitation[]

  @@index([projectId])
  @@index([phone])
}

model GuestInvitation {
  id                  String        @id @default(uuid())
  guestId             String
  invitationId        String
  uniqueToken         String        @unique
  personalizedMessage String?
  allowedEventIds     Json?         // Array of event IDs this guest is invited to
  status              String        @default("pending") // pending, sent, viewed, responded
  sentAt              DateTime?
  createdAt           DateTime      @default(now())

  guest               Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  invitation          Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvpResponse        RSVPResponse?

  @@index([guestId])
  @@index([invitationId])
  @@index([uniqueToken])
}

model RSVPResponse {
  id                 String          @id @default(uuid())
  guestInvitationId  String          @unique
  responseStatus     String          // attending, declined, tentative
  numberOfAttendees  Int             @default(1)
  dietaryPreference  String?         @default("Vegetarian") // Vegetarian, Jain, Non-Vegetarian
  message            String?
  respondedAt        DateTime        @default(now())

  guestInvitation    GuestInvitation @relation(fields: [guestInvitationId], references: [id], onDelete: Cascade)

  @@index([guestInvitationId])
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  planName      String
  slug          String         @unique
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  billingPeriod String         @default("one_time") // one_time, monthly, yearly
  features      Json
  isActive      Boolean        @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id          String           @id @default(uuid())
  userId      String
  planId      String
  status      String           @default("active") // active, expired, cancelled
  startDate   DateTime         @default(now())
  endDate     DateTime?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([userId])
  @@index([planId])
}

model Payment {
  id                   String        @id @default(uuid())
  userId               String
  subscriptionId       String?
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("INR")
  paymentProvider      String        @default("razorpay")
  transactionReference String?
  paymentStatus        String        @default("completed") // pending, completed, failed, refunded
  createdAt            DateTime      @default(now())

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription         Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model SavedTemplate {
  id         String   @id @default(uuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
}
